<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DigiTFactory.Libraries.Testing</RootNamespace>
    <AssemblyName>DigiTFactory.Libraries.Testing</AssemblyName>
    <PackageId>DigiTFactory.Libraries.Testing</PackageId>
    <Version>0.2.1</Version>
    <Description>Coverage-assertion helpers for DigiTFactory EDM microservices: verify every aggregate business method has a test (QG-702).</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

</Project>
