<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DigiTFactory.Libraries.Analyzers</RootNamespace>
    <AssemblyName>DigiTFactory.Libraries.Analyzers</AssemblyName>
    <!-- Каталог — не пакет: это рантайм-помощник DtfScan (реестр + фильтр по слою). -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.5.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Analyzers.Domain\DigiTFactory.Libraries.Analyzers.Domain.csproj" />
    <ProjectReference Include="..\Analyzers.DomainServices\DigiTFactory.Libraries.Analyzers.DomainServices.csproj" />
    <ProjectReference Include="..\Analyzers.CrossCutting\DigiTFactory.Libraries.Analyzers.CrossCutting.csproj" />
  </ItemGroup>

</Project>
